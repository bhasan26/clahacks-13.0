# Synthetic data only. Do not commit .env or paste keys into frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
DEMO_MODE=false
COVERAGEGUARD_SCHEDULER_ENABLED=false
COVERAGEGUARD_CHECK_INTERVAL=86400
# Optional for local review; required when requests are not from loopback.
# COVERAGEGUARD_REVIEW_TOKEN=choose-a-local-secret
COVERAGEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default state: backend/data/coverageguard.sqlite3. Use an empty value to disable persistence.
# COVERAGEGUARD_STATE_PATH=/absolute/path/to/coverageguard.sqlite3

# Optional publisher-issued token; CoverageGuard does not accept license terms for you.
# CMS_LICENSE_TOKEN=
COVERAGEGUARD_SYNC_DOCUMENT_LIMIT=5
# SIMULATOR_ADMIN_TOKEN=choose-a-local-demo-secret

# Optional comma-separated scheduled source IDs. Empty means all registered sources.
# COVERAGEGUARD_SCHEDULER_SOURCES=demo-insurer-api

# Commercial harvesting/indexing is disabled without publisher authorization.
# Set references only after obtaining appropriate publisher permission.
# COVERAGEGUARD_UHC_AUTHORIZATION_REFERENCE=
# COVERAGEGUARD_AETNA_AUTHORIZATION_REFERENCE=
